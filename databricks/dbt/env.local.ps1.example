# Plantilla de credenciales locales.
#
#     cp env.local.ps1.example env.local.ps1
#     # pega tu token en la linea de abajo
#
# El fichero real (`env.local.ps1`) esta en .gitignore. NUNCA lo subas.
#
# Uso (desde databricks/dbt):
#     . .\env.local.ps1
#     dbt build --profiles-dir .
#
# El punto inicial es obligatorio: "dot-sourcing" ejecuta el script en la sesion
# actual para que la variable persista. Sin el, se define en un proceso hijo y
# se pierde al terminar.

$env:DATABRICKS_TOKEN = "dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

Write-Host "DATABRICKS_TOKEN cargado en la sesion." -ForegroundColor Green
