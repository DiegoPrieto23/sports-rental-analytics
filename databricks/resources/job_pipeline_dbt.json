{
  "name": "sports_rental_dbt",
  "description": "Mismo pipeline ejecutado con dbt. Las dependencias entre capas las resuelve el propio DAG de dbt; aqui las separamos en tareas para verlas en el grafo del Job y poder reintentar una capa concreta.",
  "tags": {
    "proyecto": "sports_rental",
    "herramienta": "dbt"
  },
  "max_concurrent_runs": 1,
  "git_source": {
    "git_url": "https://github.com/TU_USUARIO/TU_REPO",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "dbt_staging",
      "description": "Construye y testea la capa staging.",
      "dbt_task": {
        "project_directory": "databricks/dbt",
        "commands": [
          "dbt deps",
          "dbt build --select staging"
        ],
        "warehouse_id": "TU_WAREHOUSE_ID",
        "catalog": "workspace",
        "schema": "staging"
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "dbt_intermediate",
      "depends_on": [
        {
          "task_key": "dbt_staging"
        }
      ],
      "dbt_task": {
        "project_directory": "databricks/dbt",
        "commands": [
          "dbt build --select intermediate"
        ],
        "warehouse_id": "TU_WAREHOUSE_ID",
        "catalog": "workspace",
        "schema": "staging"
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "dbt_marts",
      "depends_on": [
        {
          "task_key": "dbt_intermediate"
        }
      ],
      "dbt_task": {
        "project_directory": "databricks/dbt",
        "commands": [
          "dbt build --select marts",
          "dbt docs generate"
        ],
        "warehouse_id": "TU_WAREHOUSE_ID",
        "catalog": "workspace",
        "schema": "staging"
      },
      "timeout_seconds": 3600
    }
  ],
  "email_notifications": {
    "on_failure": [
      "TU_EMAIL"
    ]
  }
}
