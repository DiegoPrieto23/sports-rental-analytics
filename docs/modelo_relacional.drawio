        <mxCell id="titulo" value="Sports Rental — Modelo relacional (esquema estrella)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#33475B;" vertex="1" parent="1">
          <mxGeometry x="330" y="-40" width="520" height="40" as="geometry"/>
